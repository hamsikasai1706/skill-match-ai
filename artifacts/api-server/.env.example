# Keep this server-only key in Replit Secrets or the hosting provider's secret store.
SUPABASE_URL=https://mcrkavvinthyinosdepa.supabase.co
SUPABASE_SECRET_KEY=

# JWT_SECRET is preferred. The Replit development workspace currently provides
# SESSION_SECRET, which the API can use as a fallback when JWT_SECRET is unset.
JWT_SECRET=

# Comma-separated browser origin(s); required in production for CORS.
CLIENT_URL=http://localhost:5173

# Add this only when enabling AI explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local development values. Render supplies PORT automatically.
PORT=3001
